<Module>
<Name>agentic-interop</Name>
<Version>1.2.0</Version>
<Description>AI Copilot for InterSystems IRIS for Health. Helps integration engineers specify, build, review, and optimize healthcare interoperability workflows through natural conversation. 87 classes, 118 tools across 7 domains (Production 29, Transform 30, Testing 8, Catalog 7, Monitoring 5, FHIR Server 26, Bulk FHIR 13), 15 domain skills (Productions, BPL, DTL, RoutingRules, HL7v2, FHIRR4, FHIRServer, SDA, X12, CDA, Adapters, RestInProductions, ESBPattern, BulkFHIR, FHIRSQLBuilder), a chatbot-to-agent config layer with two shipped chatbots (Interop, FHIR Management), streaming chat with tool-call approval, vector catalog search, live Observer, System Default Settings CRUD for dev→test→live promotion, FHIR lookup-table customization, HL7 helper builders (Router/TCPService/TCPOperation/SearchTable), BPL builders (HL7→FHIR, HL7→SDA, generic UpdateBPL), FIFO group recovery (ReleaseHold), filename time-stamp preview, schedule validation, and effective-setting resolution (production → System Default → InitialExpression). Ships the InterSystems Integration Spec Questionnaire (/agentic/spec/): a schema-driven form that collects everything Health Connect needs to build an interface, with describe-it-first extraction (prose to populated form via the lean SpecExtractor agent), catalog-backed selection of inbound/outbound business hosts, adapters and existing transformations, and prose/JSON output handed straight to the chatbot. Four personas: Developer, AI Hub Admin, Interface Engineer, Operator. Built on the %AI Framework. Namespace-agnostic.</Description>
<Keywords>iris ai copilot mcp interop fhir hl7 dtl bpl sda x12 cda hipaa production agent skill adapter</Keywords>
<Packaging>module</Packaging>
<SourcesRoot>src</SourcesRoot>
<SystemRequirements>InterSystems IRIS for Health 2026.2 or later with the %AI Framework (build 162.0+)</SystemRequirements>

<!-- ObjectScript classes -->
<Resource Name="AgenticInterop.PKG"/>

<!-- Reference seed data (error codes, glossary, API topics).
     Deployed to /tmp/agentic-seed/reference/ where
     AgenticInterop.Reference.Loader reads them. -->
<FileCopy Name="src/seed/glossary.json"     Target="/tmp/agentic-seed/reference/glossary.json" />
<FileCopy Name="src/seed/error_codes.json"  Target="/tmp/agentic-seed/reference/error_codes.json" />
<FileCopy Name="src/seed/api_topics.json"   Target="/tmp/agentic-seed/reference/api_topics.json" />

<!-- Curated class catalog XLS for vector-search KB ingestion.
     Deployed to /opt/agentic_interop/seeds/ where
     AgenticInterop.Catalog.Builder reads it. -->
<FileCopy Name="seeds/InterSystems_IRIS_Health_Complete_Class_Catalog.xlsx"
          Target="/opt/agentic_interop/seeds/catalog.xlsx" />

<!-- Static UI bundle (HTML/CSS/JS for /agentic/ and /agentic/admin/).
     Authenticated only — no anonymous access. The user must already
     have an IRIS session before any agentic_interop asset is served
     (restriction #3: no UI visible to unauthenticated users).
     UseCookies=0 + CSRFToken=0 + SessionScope=0: fully stateless.
     Sessions cause 401 on the second chat turn — the CSP gateway
     creates a session on the first POST (SSE stream), then the browser
     sends the stale session cookie on the second POST, and CSRF token
     validation fails before our Dispatch code even runs. -->
<CSPApplication
    Url="/agentic"
    Path="${cspdir}agentic"
    DeployPath="agentic"
    SourcePath="${root}src/csp/agentic"
    Recurse="1"
    AuthenticationMethods="32"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="0"
    UseCookies="0"
    AutoCompile="0"
    DefaultTimeout="900"
    CookiePath="/"
    GroupById="%ISCMgtPortal"
    Description="agentic_interop static UI bundle (chat + admin) — authenticated only (restriction #3: no UI before login), stateless (no sessions/cookies/CSRF)"
/>

<!-- REST API. JWTAuthEnabled=1 + GroupById=%ISCMgtPortal so the IRIS
     JWT the Interop SPA already holds authenticates here too — no
     second login. AutheEnabled=32 (Password auth) lets the dispatch
     class enforce auth via OnPreDispatch ($username check) and write
     an audit row for both successes and rejections.
     UseCookies=0 + CSRFToken disabled + SessionScope=0: fully
     stateless REST. Every request authenticates via the Authorization
     header (Basic or JWT). No session cookies, no CSRF tokens.
     Previous UseCookies=2 caused 401 on the second chat turn because
     the CSP gateway created a session on the first SSE POST, then
     CSRF validation failed on the next POST before our code ran. -->
<CSPApplication
    Url="/api/agentic"
    DispatchClass="AgenticInterop.REST.Dispatch"
    AuthenticationMethods="32"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="0"
    JWTAuthEnabled="1"
    UseCookies="0"
    AutoCompile="0"
    CookiePath="/"
    GroupById="%ISCMgtPortal"
    Description="agentic_interop REST API — stateless (no sessions/cookies/CSRF), auth via Authorization header + audited"
/>

<!-- Patch the shipped IRIS Interop Editor to load /agentic/inject.js
     so the AI Configuration + AI Chatbot buttons appear at the top of
     /ui/interop/interop-editor/index.html. Idempotent; backs up
     the original on first run; reverted on uninstall. -->
<Invoke Class="AgenticInterop.Install.CSPTimeoutPatch" Method="Apply" Phase="Activate" />

<!-- Map the AgenticInterop package from HSCUSTOM into FHIR / USER / PAYER so
     the chatbot's tools can call back into AgenticInterop.Agent.Manager (and
     other AgenticInterop classes) after they switch $namespace to the user's
     selected namespace. Without this, every Manager.ToolDone() throws
     <CLASS DOES NOT EXIST> in non-HSCUSTOM namespaces and the agent reports
     "tool execution failed" for every monitoring/CRUD call. HSCUSTOM remains
     the only namespace where AgenticInterop code is deployed; this only adds
     a visibility mapping. Idempotent. -->
<Invoke Class="AgenticInterop.Install.PackageMapping" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.PackageMapping" Method="Revert" Phase="UnConfigure" />

<!-- Provision the IRIS-standard OAuth 2.0 client credentials config used
     by the universal HL7-to-FHIR pipeline's outbound HTTPOperation. Creates
     SSL config FHIR-Client-SSL, OAuth2.ServerDefinition for the auth server
     issuer, and OAuth2.Client FHIR-OAuth-Client (ClientType=confidential,
     grant_types=client_credentials). Issuer + endpoints + ClientId/Secret
     start as placeholders; operator updates them via the Management Portal
     when the real FHIR server URL is known. Idempotent. -->
<Invoke Class="AgenticInterop.Install.FHIRClientOAuthSetup" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.FHIRClientOAuthSetup" Method="Revert" Phase="UnConfigure" />

<!-- Seed the symbolic production/interop error-code catalog (~268 codes:
     Production, Workflow, XPath, EDI, HL7 v2, X12 SEF/routing, DICOM) into
     ^AgInt.ProdErr. The explain_production_error tool reads it so the agent
     can decode the named Err* / status tokens it sees in the Event Log.
     Idempotent — re-seeds from the class's Catalog XData on every activate. -->
<Invoke Class="AgenticInterop.Reference.ProductionError" Method="Seed" Phase="Activate" />

<!-- Seed the system runtime error catalog (~226 entries: the <ANGLE BRACKET>
     ObjectScript runtime errors, the <NETWORK DATA UPDATE FAILED ...> family,
     and the ISO 11756 Mnn $ECODE codes) into ^AgInt.SysErr. The
     explain_system_error tool reads it so the agent can decode the <...>
     tokens it sees in $ZERROR, stack traces, and failed tool results.
     Idempotent — re-seeds from the class's Catalog XData on every activate. -->
<Invoke Class="AgenticInterop.Reference.SystemError" Method="Seed" Phase="Activate" />

<!-- Seed the two shipped chatbots for the chatbot config layer:
     interop -> Health Interop (generalist), fhir-management -> FHIR
     Specialist. Idempotent; never overwrites a user-edited row. -->
<Invoke Class="AgenticInterop.Data.Chatbot" Method="EnsureSeed" Phase="Activate" />

<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Revert" Phase="UnConfigure" />

<!-- Inject the floating FHIR chatbot launcher into the shipped FHIR
     Server Management page (/csp/fhir-management -> isc-fhir/index.html).
     Bound to the fhir-management chatbot (FHIR Specialist agent).
     Idempotent; reverted on uninstall; auto-skipped if the FHIR
     Management UI isn't installed. -->
<Invoke Class="AgenticInterop.Install.FHIRManagementPatch" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.FHIRManagementPatch" Method="Revert" Phase="UnConfigure" />

