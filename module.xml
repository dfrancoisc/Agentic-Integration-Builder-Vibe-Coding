<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
<Document name="agentic-interop.ZPM">
<Module>
<Name>agentic-interop</Name>
<Version>0.1.0</Version>
<Description>Configuration-driven AI Copilot for InterSystems IRIS for Health. Built on the %AI Framework. Namespace-agnostic — installs into the namespace where zpm load is run.</Description>
<Keywords>iris ai copilot mcp interop fhir hl7</Keywords>
<Packaging>module</Packaging>
<SourcesRoot>src</SourcesRoot>

<!-- ObjectScript classes -->
<Resource Name="AgenticInterop.PKG"/>

<!-- Static UI bundle (HTML/CSS/JS for /agentic/ and /agentic/admin/) -->
<CSPApplication
    Url="/agentic"
    Path="${cspdir}agentic"
    DeployPath="agentic"
    SourcePath="${root}src/csp/agentic"
    Recurse="1"
    AuthenticationMethods="64"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="1"
    UseCookies="1"
    AutoCompile="0"
    DefaultTimeout="900"
    CookiePath="/agentic/"
    UseSessionCookie="0"
    Description="agentic_interop static UI bundle (chat + admin)"
/>

<!-- REST API. Type=2 (REST), UseSession=0 (avoid iframe deadlock),
     UnauthenticatedEnabled=1 for now — will gate by namespace access in
     Dispatch.OnPreDispatch once auth is wired in Phase 1. -->
<CSPApplication
    Url="/api/agentic"
    DispatchClass="AgenticInterop.REST.Dispatch"
    AuthenticationMethods="64"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="1"
    UseSessionCookie="0"
    UseCookies="1"
    AutoCompile="0"
    Description="agentic_interop REST API"
/>

<!-- Patch the shipped IRIS Interop Editor to load /agentic/inject.js
     so the AI Configuration + AI Chatbot buttons appear at the top of
     /ui/interop/interop-editor/index.html. Idempotent; backs up
     the original on first run; reverted on uninstall. -->
<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Revert" Phase="UnConfigure" />

</Module>
</Document>
</Export>
