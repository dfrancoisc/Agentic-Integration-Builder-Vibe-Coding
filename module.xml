<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
<Document name="agentic-interop.ZPM">
<Module>
<Name>agentic-interop</Name>
<Version>0.1.0</Version>
<Description>Configuration-driven AI Copilot for InterSystems IRIS for Health. Built on the %AI Framework. Namespace-agnostic — installs into the namespace where zpm load is run.</Description>
<Keywords>iris ai copilot mcp interop fhir hl7</Keywords>
<Packaging>module</Packaging>
<SourcesRoot>src</SourcesRoot>

<!-- ObjectScript classes -->
<Resource Name="AgenticInterop.PKG"/>

<!-- Reference seed data (error codes, glossary, API topics).
     Deployed to /tmp/agentic-seed/reference/ where
     AgenticInterop.Reference.Loader reads them. -->
<FileCopy Name="src/seed/glossary.json"     Target="/tmp/agentic-seed/reference/glossary.json" />
<FileCopy Name="src/seed/error_codes.json"  Target="/tmp/agentic-seed/reference/error_codes.json" />
<FileCopy Name="src/seed/api_topics.json"   Target="/tmp/agentic-seed/reference/api_topics.json" />

<!-- Curated class catalog XLS for vector-search KB ingestion.
     Deployed to /opt/agentic_interop/seeds/ where
     AgenticInterop.Catalog.Builder reads it. -->
<FileCopy Name="seeds/InterSystems_IRIS_Health_Complete_Class_Catalog.xlsx"
          Target="/opt/agentic_interop/seeds/catalog.xlsx" />

<!-- Static UI bundle (HTML/CSS/JS for /agentic/ and /agentic/admin/).
     Authenticated only — no anonymous access. The user must already
     have an IRIS session before any agentic_interop asset is served
     (restriction #3: no UI visible to unauthenticated users). -->
<CSPApplication
    Url="/agentic"
    Path="${cspdir}agentic"
    DeployPath="agentic"
    SourcePath="${root}src/csp/agentic"
    Recurse="1"
    AuthenticationMethods="96"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="1"
    UseCookies="1"
    AutoCompile="0"
    DefaultTimeout="900"
    CookiePath="/"
    GroupById="%ISCMgtPortal"
    UseSessionCookie="0"
    Description="agentic_interop static UI bundle (chat + admin) — authenticated"
/>

<!-- REST API. JWTAuthEnabled=1 + GroupById=%ISCMgtPortal so the IRIS
     JWT the Interop SPA already holds authenticates here too — no
     second login. AutheEnabled=32 (allow unauth at gateway) lets the
     dispatch class enforce auth itself; OnPreDispatch rejects
     $username = "" or "UnknownUser" with 401, and writes an audit row
     for both successes and rejections. UseCookies=2 disables the
     per-app session cookie so we don't fight the shared-session
     model. -->
<CSPApplication
    Url="/api/agentic"
    DispatchClass="AgenticInterop.REST.Dispatch"
    AuthenticationMethods="32"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="1"
    JWTAuthEnabled="1"
    UseSessionCookie="0"
    UseCookies="2"
    AutoCompile="0"
    CookiePath="/"
    GroupById="%ISCMgtPortal"
    Description="agentic_interop REST API — authenticated via shared IRIS JWT + audited"
/>

<!-- Patch the shipped IRIS Interop Editor to load /agentic/inject.js
     so the AI Configuration + AI Chatbot buttons appear at the top of
     /ui/interop/interop-editor/index.html. Idempotent; backs up
     the original on first run; reverted on uninstall. -->
<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Revert" Phase="UnConfigure" />

</Module>
</Document>
</Export>
