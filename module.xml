<Document name="agentic-interop.ZPM">
<Module>
<Name>agentic-interop</Name>
<Version>1.0.0</Version>
<Description>AI Copilot for InterSystems IRIS for Health. Helps integration engineers build, review, and optimize healthcare interoperability workflows through natural conversation. 78 classes, 86 tools across 7 domains (Production, Transform, Testing, Catalog, Monitoring, FHIR Server, Bulk FHIR), 15 domain skills, a chatbot-to-agent config layer with two shipped chatbots (Interop, FHIR Management), streaming chat with tool-call approval, vector catalog search, and live Observer for behind-the-scenes computation view. Four personas: Developer, AI Hub Admin, Interface Engineer, Operator. Built on the %AI Framework. Namespace-agnostic.</Description>
<Keywords>iris ai copilot mcp interop fhir hl7 dtl bpl sda x12 cda hipaa production agent skill adapter</Keywords>
<Packaging>module</Packaging>
<SourcesRoot>src</SourcesRoot>
<SystemRequirements>InterSystems IRIS for Health 2026.2 or later with the %AI Framework (build 162.0+)</SystemRequirements>

<!-- ObjectScript classes -->
<Resource Name="AgenticInterop.PKG"/>

<!-- Reference seed data (error codes, glossary, API topics).
     Deployed to /tmp/agentic-seed/reference/ where
     AgenticInterop.Reference.Loader reads them. -->
<FileCopy Name="src/seed/glossary.json"     Target="/tmp/agentic-seed/reference/glossary.json" />
<FileCopy Name="src/seed/error_codes.json"  Target="/tmp/agentic-seed/reference/error_codes.json" />
<FileCopy Name="src/seed/api_topics.json"   Target="/tmp/agentic-seed/reference/api_topics.json" />

<!-- Curated class catalog XLS for vector-search KB ingestion.
     Deployed to /opt/agentic_interop/seeds/ where
     AgenticInterop.Catalog.Builder reads it. -->
<FileCopy Name="seeds/InterSystems_IRIS_Health_Complete_Class_Catalog.xlsx"
          Target="/opt/agentic_interop/seeds/catalog.xlsx" />

<!-- Static UI bundle (HTML/CSS/JS for /agentic/ and /agentic/admin/).
     Authenticated only — no anonymous access. The user must already
     have an IRIS session before any agentic_interop asset is served
     (restriction #3: no UI visible to unauthenticated users).
     UseCookies=0 + CSRFToken=0 + SessionScope=0: fully stateless.
     Sessions cause 401 on the second chat turn — the CSP gateway
     creates a session on the first POST (SSE stream), then the browser
     sends the stale session cookie on the second POST, and CSRF token
     validation fails before our Dispatch code even runs. -->
<CSPApplication
    Url="/agentic"
    Path="${cspdir}agentic"
    DeployPath="agentic"
    SourcePath="${root}src/csp/agentic"
    Recurse="1"
    AuthenticationMethods="32"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="0"
    UseCookies="0"
    AutoCompile="0"
    DefaultTimeout="900"
    CookiePath="/"
    GroupById="%ISCMgtPortal"
    Description="agentic_interop static UI bundle (chat + admin) — authenticated only (restriction #3: no UI before login), stateless (no sessions/cookies/CSRF)"
/>

<!-- REST API. JWTAuthEnabled=1 + GroupById=%ISCMgtPortal so the IRIS
     JWT the Interop SPA already holds authenticates here too — no
     second login. AutheEnabled=32 (Password auth) lets the dispatch
     class enforce auth via OnPreDispatch ($username check) and write
     an audit row for both successes and rejections.
     UseCookies=0 + CSRFToken disabled + SessionScope=0: fully
     stateless REST. Every request authenticates via the Authorization
     header (Basic or JWT). No session cookies, no CSRF tokens.
     Previous UseCookies=2 caused 401 on the second chat turn because
     the CSP gateway created a session on the first SSE POST, then
     CSRF validation failed on the next POST before our code ran. -->
<CSPApplication
    Url="/api/agentic"
    DispatchClass="AgenticInterop.REST.Dispatch"
    AuthenticationMethods="32"
    PasswordAuthEnabled="1"
    UnauthenticatedEnabled="0"
    JWTAuthEnabled="1"
    UseCookies="0"
    AutoCompile="0"
    CookiePath="/"
    GroupById="%ISCMgtPortal"
    Description="agentic_interop REST API — stateless (no sessions/cookies/CSRF), auth via Authorization header + audited"
/>

<!-- Patch the shipped IRIS Interop Editor to load /agentic/inject.js
     so the AI Configuration + AI Chatbot buttons appear at the top of
     /ui/interop/interop-editor/index.html. Idempotent; backs up
     the original on first run; reverted on uninstall. -->
<Invoke Class="AgenticInterop.Install.CSPTimeoutPatch" Method="Apply" Phase="Activate" />

<!-- Seed the two shipped chatbots for the chatbot config layer:
     interop -> Health Interop (generalist), fhir-management -> FHIR
     Specialist. Idempotent; never overwrites a user-edited row. -->
<Invoke Class="AgenticInterop.Data.Chatbot" Method="EnsureSeed" Phase="Activate" />

<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.InteropEditorPatch" Method="Revert" Phase="UnConfigure" />

<!-- Inject the floating FHIR chatbot launcher into the shipped FHIR
     Server Management page (/csp/fhir-management -> isc-fhir/index.html).
     Bound to the fhir-management chatbot (FHIR Specialist agent).
     Idempotent; reverted on uninstall; auto-skipped if the FHIR
     Management UI isn't installed. -->
<Invoke Class="AgenticInterop.Install.FHIRManagementPatch" Method="Apply" Phase="Activate" />
<Invoke Class="AgenticInterop.Install.FHIRManagementPatch" Method="Revert" Phase="UnConfigure" />

</Module>
