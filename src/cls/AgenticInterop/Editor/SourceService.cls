/// Returns the compiled class source as UDL text so the admin UI can
/// show "behind the scenes" what the editor is producing. Read-only —
/// the UI uses ParameterDefinition / XDataDefinition writers, not raw
/// source uploads.
///
/// UDL is generated by %Compiler.UDL.TextServices.GetTextAsArray which
/// returns the same .cls form a developer would author by hand.
Class AgenticInterop.Editor.SourceService Extends %RegisteredObject
{

/// GET /api/agentic/source/:class
ClassMethod Get(pResponse As %CSP.Response, pClass As %String) As %Status
{
    Set util = "AgenticInterop.Editor.Util"
    If pClass = "" {
        Quit $classmethod(util, "WriteError", pResponse, "400 Bad Request", "Missing class name")
    }
    If '##class(%Dictionary.CompiledClass).%ExistsId(pClass) {
        Quit $classmethod(util, "WriteError", pResponse, "404 Not Found", "Class does not exist", pClass)
    }
    Set source = ""
    Set tSC = $$$OK
    Try {
        // Signature: GetTextAsArray(namespace, className-with-.cls, *text)
        Kill arr
        Set tSC = ##class(%Compiler.UDL.TextServices).GetTextAsArray($namespace, pClass _ ".cls", .arr)
        If tSC {
            // arr(0) holds the line count; lines themselves are at arr(1..N).
            Set n = +$get(arr, 0)
            If n = 0 { Set n = +$get(arr(0), 0) }
            For i=1:1:n { Set source = source _ $get(arr(i)) _ $CHAR(10) }
        }
    } Catch ex {
        Set tSC = ex.AsStatus()
    }
    If 'tSC {
        Quit $classmethod(util, "WriteError", pResponse, "500 Internal Server Error", "Failed to read source", $system.Status.GetErrorText(tSC))
    }
    Set body = {
        "class":  (pClass),
        "format": "udl",
        "lines":  ($LENGTH(source, $CHAR(10))),
        "bytes":  ($LENGTH(source)),
        "source": (source)
    }
    Quit $classmethod(util, "WriteJSON", pResponse, body)
}

}
